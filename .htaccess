# Tagada — one.com (Apache)

ErrorDocument 404 /index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the bare domain (www.tagada.be -> tagada.be)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://tagada.be/$1 [R=301,L]

# Old site (iWeb, /Tagada/...) -> new pages
RewriteRule ^Tagada/(Lettering|POS|Spectacular|Visual)\.html$ https://tagada.be/realisations.html [R=301,L,NC]
RewriteRule ^Tagada(/.*)?$ https://tagada.be/ [R=301,L,NC]
</IfModule>

# Browser caching: images and fonts change rarely, pages always revalidate
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType image/x-icon "access plus 1 month"
ExpiresByType font/ttf "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
